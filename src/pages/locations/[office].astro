---
// Office page (multi-location Build 3, 2026-10-19). One page per real
// SECONDARY office, from the `offices` collection that scripts/office_pages.py
// writes out of the company_locations row (single source of truth). Its
// Google Business Profile links here, so every fact on this page is THIS
// office's: name, address, phone, hours, map and LocalBusiness schema. The
// site-wide LocalBusiness node (main office NAP) is deliberately NOT emitted
// on this page; the office node points at the brand with parentOrganization.
// The office phone is not the brand phone, so the call-tracking swap
// (DniSwap) leaves it alone. No offices = no pages (getStaticPaths is empty).
import { getCollection } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import { brand } from "~/lib/brand";

export async function getStaticPaths() {
  const offices = await getCollection("offices");
  return offices.map((o) => ({ params: { office: o.data.office_slug }, props: { entry: o } }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const o = entry.data;
const heroImage = o.hero || "/images/hero-bg.webp";
const pageUrl = `${brand.canonicalUrl}/locations/${o.office_slug}/`;
const fullAddress = `${o.street}, ${o.city}, ${o.state}${o.zip ? ` ${o.zip}` : ""}`;
const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent(fullAddress)}&output=embed`;
const directionsHref = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(fullAddress)}`;
const abs = (u: string) => (u.startsWith("http") ? u : new URL(u, brand.canonicalUrl).href);

// Services with a written page, in the order office_pages.py chose
// (curated homepage core first). A service page hidden at build time
// simply drops out of the collection, so no link here can 404.
const bySlug = new Map((await getCollection("services")).map((s) => [s.data.service_slug, s]));
const services = o.services
  .map((slug) => bySlug.get(slug))
  .filter((s): s is NonNullable<typeof s> => !!s && (s.data as any).rendered !== false);

const officeSchema = {
  "@context": "https://schema.org",
  "@type": o.is_247 ? ["LocalBusiness", "EmergencyService"] : "LocalBusiness",
  "@id": `${pageUrl}#localbusiness`,
  name: o.display_name,
  ...(o.display_name !== brand.displayName ? { alternateName: brand.displayName } : {}),
  url: pageUrl,
  telephone: o.phone,
  ...(brand.email ? { email: brand.email } : {}),
  image: abs(brand.logoUrl),
  logo: abs(brand.logoUrl),
  priceRange: "$$",
  address: {
    "@type": "PostalAddress",
    streetAddress: o.street,
    addressLocality: o.city,
    addressRegion: o.state,
    ...(o.zip ? { postalCode: o.zip } : {}),
    addressCountry: "US",
  },
  ...(o.lat != null && o.lng != null
    ? { geo: { "@type": "GeoCoordinates", latitude: o.lat, longitude: o.lng } }
    : {}),
  ...(o.hours_spec.length
    ? {
        openingHoursSpecification: o.hours_spec.map((h) => ({
          "@type": "OpeningHoursSpecification",
          dayOfWeek: h.days,
          opens: h.opens,
          closes: h.closes,
        })),
      }
    : {}),
  areaServed: [
    { "@type": "City", name: `${o.city}, ${o.state}` },
    ...o.nearby_areas.map((a) => ({ "@type": "City", name: `${a.city}, ${a.state}` })),
  ],
  hasMap: directionsHref,
  ...(o.gbp_url ? { sameAs: [o.gbp_url] } : {}),
  parentOrganization: {
    "@type": "Organization",
    "@id": `${brand.canonicalUrl}/#organization`,
    name: brand.dbaName || brand.legalName || brand.displayName,
    url: brand.canonicalUrl,
  },
};
---

<BaseLayout
  title={o.title}
  meta_description={o.meta_description}
  hero_image_url={heroImage}
  schema_stubs={["organization", "breadcrumb-list"]}
  schema_ctx={{ archetype: "office", city: o.city, state: o.state }}
  breadcrumb={o.breadcrumb}
  faq={o.faq}
>
  <script type="application/ld+json" set:html={JSON.stringify(officeSchema)}></script>

  <!-- HERO -->
  <section class="relative min-h-[380px] flex items-center overflow-hidden bg-white border-b border-dark/10">
    <div class="absolute inset-0 z-0">
      <img src={heroImage} alt={`${o.display_name}, ${o.city}, ${o.state}`} class="w-full h-full object-cover" loading="eager" />
      <div class="absolute inset-0 bg-gradient-to-r from-white/95 via-white/85 to-white/30"></div>
    </div>
    <div class="container-wide relative z-10 py-16">
      <div class="max-w-3xl">
        <div class="eyebrow">{o.city}, {o.state} Office</div>
        <h1 class="mb-6">{o.display_name}</h1>
        <p class="text-lg text-dark/85 mb-8 leading-relaxed">{fullAddress}</p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href={`tel:${o.phone}`} class="btn-accent">📞 Call {o.phone_display}</a>
          <a href={directionsHref} target="_blank" rel="noopener" class="btn-outline">Get Directions</a>
        </div>
      </div>
    </div>
  </section>

  <!-- OFFICE NAP + MAP -->
  <section class="section-first bg-dark-50">
    <div class="container-wide">
      <div class="grid md:grid-cols-2 gap-6 items-stretch">
        <div class="bg-white rounded-xl p-6 md:p-8 shadow-2xl flex flex-col">
          <div class="text-slate-900 font-black text-xl md:text-2xl leading-tight">{o.display_name}</div>
          <div class="text-slate-500 text-sm mt-1">{o.city}, {o.state} office of {brand.displayName}</div>
          <div class="border-t border-slate-100 my-4"></div>
          <address class="not-italic space-y-2.5 text-sm text-slate-700">
            <div class="flex gap-2.5"><span aria-hidden="true">📍</span><span>{fullAddress}</span></div>
            <div class="flex gap-2.5"><span aria-hidden="true">📞</span><a href={`tel:${o.phone}`} class="text-blue-600 font-bold">{o.phone_display}</a></div>
            {o.hours_text && (
              <div class="flex gap-2.5"><span aria-hidden="true">🕑</span><span>{o.hours_text}</span></div>
            )}
          </address>
          <div class="flex flex-col sm:flex-row gap-3 mt-6 pt-2">
            <a href={`tel:${o.phone}`} class="flex-1 text-center rounded-lg bg-navy text-white font-black py-3 px-4 hover:opacity-90 transition">
              📞 Call the {o.city} Office
            </a>
            <a href={directionsHref} target="_blank" rel="noopener" class="flex-1 text-center rounded-lg border-2 border-navy/20 text-navy font-black py-3 px-4 hover:bg-navy/5 transition">
              Get Directions
            </a>
          </div>
          {o.gbp_url && (
            <a href={o.gbp_url} target="_blank" rel="noopener" class="mt-4 text-sm font-bold text-primary-700">See this office on Google →</a>
          )}
        </div>
        <div class="rounded-xl overflow-hidden border border-dark/10 shadow-2xl min-h-[340px]">
          <iframe
            src={mapSrc}
            width="100%"
            height="380"
            style="border:0; display:block; width:100%; height:100%; min-height:340px;"
            allowfullscreen
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title={`Map: ${o.display_name}, ${fullAddress}`}
          ></iframe>
        </div>
      </div>
    </div>
  </section>

  <!-- ABOUT THIS OFFICE -->
  <section class="section bg-white">
    <div class="container-wide">
      <div class="prose-body">
        <h2 class="text-2xl md:text-3xl font-black uppercase tracking-tighter">About Our {o.city} Office</h2>
        <Content />
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  {services.length > 0 && (
    <section class="section bg-dark-50">
      <div class="container-wide">
        <div class="text-center mb-12">
          <div class="eyebrow">{o.city}, {o.state}</div>
          <h2>Services From Our {o.city} Office</h2>
        </div>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {services.map((s) => (
            <a href={`/services/${s.data.service_slug}/`} class="group block p-6 rounded-lg border border-dark/10 bg-white hover:border-primary/40 transition-all no-underline">
              <div class="text-lg font-bold text-dark-900 mb-2">{s.data.service_display}</div>
              <span class="text-xs font-black uppercase tracking-widest text-primary-700 group-hover:text-dark-900 transition-colors">
                View service →
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CTA (the office line, not the main number) -->
  <section class="relative py-12 bg-dark-800 overflow-hidden">
    <div class="container-wide px-6 relative z-10 flex flex-col md:flex-row items-center justify-between gap-8">
      <div class="text-left max-w-2xl">
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-2 tracking-tight">
          {o.is_247 ? `Need help in ${o.city} right now?` : `Planning a project in ${o.city}?`}
        </h2>
        <p class="text-lg text-white/80">
          Call our {o.city} office{o.is_247 ? ", day or night" : ""}.
        </p>
      </div>
      <div class="flex flex-col sm:flex-row gap-4 shrink-0">
        <a href={`tel:${o.phone}`} class="inline-flex items-center justify-center font-bold px-8 py-3 rounded-md transition-all text-lg shadow-lg bg-cta text-cta-fg hover:bg-cta-hover">
          Call {o.phone_display}
        </a>
        <a href="/contact/#estimate" class="inline-flex items-center justify-center font-bold px-8 py-3 rounded-md transition-all text-lg border-2 border-white text-white hover:bg-white/10">
          Get a Free Estimate
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

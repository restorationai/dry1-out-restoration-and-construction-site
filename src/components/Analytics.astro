---
// Analytics.astro — GA4 + Microsoft Clarity tags.
// No-op when the corresponding id is empty, so it's safe to include everywhere.
// IDs live in brand.ts (ga4MeasurementId / clarityProjectId), set post-scaffold
// by scripts/analytics_set.py (or create_ga4.py for GA4).
import { brand } from "~/lib/brand";
const ga4 = (brand as any).ga4MeasurementId || "";
const clarity = (brand as any).clarityProjectId || "";
// Client-owned tags (their own Google Ads account and Meta pixel), separate
// from our ads_provision gadsId so neither overwrites the other.
const clientGtag = (brand as any).clientGoogleTagId || "";
const metaPixel = (brand as any).metaPixelId || "";
---
{ga4 && (
  <Fragment>
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga4}`}></script>
    <script is:inline define:vars={{ ga4 }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){ dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', ga4);

      // Conversion signals -> GA4 events. Mark 'click_to_call' + 'generate_lead' as
      // KEY EVENTS in GA4, then import them into Google Ads. Delegated listeners so
      // every phone link (tel:) and form on the site is covered from one place.
      document.addEventListener('click', function (e) {
        var a = e.target && e.target.closest && e.target.closest('a[href^="tel:"]');
        if (a) gtag('event', 'click_to_call', {
          transport_type: 'beacon',
          phone_number: (a.getAttribute('href') || '').replace('tel:', '')
        });
      }, true);
      document.addEventListener('submit', function (e) {
        if (e.target && e.target.tagName === 'FORM')
          gtag('event', 'generate_lead', { transport_type: 'beacon' });
      }, true);
    </script>
  </Fragment>
)}
{clarity && (
  <script is:inline define:vars={{ clarity }}>
    (function(c,l,a,r,i,t,y){
      c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
      t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
      y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
    })(window, document, "clarity", "script", clarity);
  </script>
)}
{clientGtag && (
  <Fragment>
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${clientGtag}`}></script>
    <script is:inline define:vars={{ clientGtag }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){ dataLayer.push(arguments); }
      window.gtag = window.gtag || gtag;
      gtag('js', new Date());
      gtag('config', clientGtag);
    </script>
  </Fragment>
)}
{metaPixel && (
  <Fragment>
    <script is:inline define:vars={{ metaPixel }}>
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window, document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', metaPixel);
      fbq('track', 'PageView');
    </script>
    <noscript><img height="1" width="1" style="display:none" alt=""
      src={`https://www.facebook.com/tr?id=${metaPixel}&ev=PageView&noscript=1`} /></noscript>
  </Fragment>
)}

---
/**
 * Service-areas hub grid — "Proudly Serving" clickable city tiles rendered
 * above the prose on /service-areas/. Simple clean tiles (city + state), each
 * a link to /service-areas/{slug}/. No images by design.
 */
import { MapPin } from '@lucide/astro';
import { brand } from '~/lib/brand';
// "Our offices" (multi-location Build 3): renders nothing without offices
import OfficesBlock from '~/components/ui/OfficesBlock.astro';
// Cole 2026-11-18: two columns side by side, San Diego (Vista) and Bay Area
// (Hayward), each office's cities underneath it.
import { getAreaRegions } from '~/lib/areaRegions';

const regions = await getAreaRegions();
---

<section class="bg-white py-16 border-b border-dark/10">
  <div class="container-wide">
    <h2 class="text-2xl md:text-3xl font-black uppercase tracking-tighter text-dark-900 mb-8">Proudly Serving North San Diego County &amp; the Bay Area</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-10 lg:gap-12">
      {regions.map((region) => (
        <div data-area-region={region.label}>
          <h3 class="text-xl md:text-2xl font-black uppercase tracking-tighter text-dark-900 mb-1">{region.label}</h3>
          {region.office && <p class="text-sm font-bold uppercase tracking-widest text-primary-600 mb-5">{region.office}</p>}
          <div class={`grid grid-cols-1 sm:grid-cols-2 gap-3 ${region.office ? "" : "mt-5"}`}>
            {region.areas.map((area) => (
              <a
                href={`/service-areas/${area.data.area_slug}/`}
                class="group flex items-center gap-3 border border-dark/15 bg-white px-4 py-3 shadow-sm no-underline hover:no-underline hover:border-primary-500 hover:bg-primary-50 transition-all"
              >
                <MapPin size={18} class="text-primary-500 shrink-0 group-hover:scale-110 transition-transform" />
                <span class="text-dark-900 font-black uppercase tracking-tight text-sm leading-tight group-hover:text-primary-600 transition-colors">{area.data.city}, {area.data.state}</span>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section><OfficesBlock />

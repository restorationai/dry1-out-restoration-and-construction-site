---
// HOMEPAGE AWARDS SECTION (Santino 2026-11-01, after the Life Savers and
// Desert Valley previews): awards get their OWN section, directly after the
// proof section ("Why {city} homeowners choose ..."), never squeezed between
// the rating line and the review cards.
//
// H2 + intro come from brand.ts awardsSection (scripts/award_wording.py
// section_copy: "Voted and Rated the Best in Las Vegas" / "Independent
// recognition from the Las Vegas Review-Journal and Expertise.com."), the
// same wording the JSON-LD award strings and llms.txt use. Cards are
// strongest first; each shows the real badge image we hold (else a medal
// icon), the kind-correct title, source + year, and a visible "See the
// award" link to the page that gave it. Never-link programs (BusinessRate)
// carry no url, so no link. No new assets beyond badges the site already has.
import { Award, ExternalLink } from "@lucide/astro";
import { awards, awardSeal, awardsSection, yearOfAward } from "~/lib/awards";

const list = awards().slice(0, 6);
const sec = awardsSection();
const headline = sec?.headline || "Awards and Recognition";
const intro = sec?.intro || "";
const titleOf = (a: (typeof list)[number]) => a.cardTitle || awardSeal(a).title;
const metaOf = (a: (typeof list)[number]) => [a.organizer, yearOfAward(a)].filter(Boolean).join(" · ");
---

{list.length > 0 && (
  <section id="awards" class="bg-white py-16 sm:py-20 border-b border-dark/10 text-dark-900" aria-labelledby="awards-heading">
    <div class="mx-auto max-w-6xl px-4 sm:px-8">
      <div class="max-w-3xl mx-auto text-center">
        <h2 id="awards-heading" class="m-0 text-2xl sm:text-4xl font-black uppercase tracking-tighter text-balance">{headline}</h2>
        {intro && <p class="mt-3 mb-0 text-base sm:text-lg text-dark-600">{intro}</p>}
      </div>
      <ul class="mt-10 mb-0 p-0 list-none flex flex-wrap justify-center gap-4" role="list">
        {list.map((a) => (
          <li class="flex w-full sm:w-[calc(50%-0.5rem)] lg:w-[calc(33.333%-0.75rem)]">
            <article class="flex w-full items-start gap-4 rounded-2xl border border-amber-300/70 bg-white p-5 shadow-sm">
              {a.image ? (
                <img src={a.image} alt={`${titleOf(a)}, ${metaOf(a)}`} width="80" height="80" loading="lazy" decoding="async"
                  class="h-20 w-20 shrink-0 object-contain" />
              ) : (
                <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-gradient-to-b from-amber-300 to-amber-500 text-white ring-4 ring-amber-100" aria-hidden="true">
                  <Award size={26} strokeWidth={2.5} />
                </span>
              )}
              <div class="flex min-w-0 flex-col gap-1">
                <h3 class="m-0 text-base font-black leading-snug text-dark-900">{titleOf(a)}</h3>
                {metaOf(a) && <p class="m-0 text-sm font-semibold text-dark-500">{metaOf(a)}</p>}
                {a.url && (
                  <a href={a.url} target="_blank" rel="noopener"
                    class="mt-1 inline-flex items-center gap-1 text-sm font-bold text-primary-700 underline underline-offset-2">
                    See the award<span class="sr-only">: {titleOf(a)}</span>
                    <ExternalLink size={14} aria-hidden="true" />
                  </a>
                )}
              </div>
            </article>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

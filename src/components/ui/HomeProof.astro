---
// 2026-10-04 (Santino, Dry1 review): stat tiles REMOVED from the template
// and every site; headline capped at two lines (short name when the full
// name is long, else "us"). Applied by scripts/home_proof_slim.py.
// HomeProof: "Why {City} homeowners choose {Brand}" (Santino 2026-10-03).
//
// The homepage does NOT carry a "The Best Restoration Company in {City}"
// headline (an unverifiable self-superlative). It earns "best" with proof:
// the real Google rating + review count, licenses and certifications on file,
// the founding year on file, 24/7 / response time only when the brand truth
// allows it, and a few real review excerpts. Every piece is data-driven and
// simply omitted when the data is missing; the whole section renders nothing
// when there is no proof at all.
//
// "top-rated {trade} company in {City}" appears ONLY when the synced Google
// rating is >= 4.5 across >= 20 reviews (TOP_RATED_* below).
//
// Data: brand.ts only. gbpRatingValue / gbpReviewCount / gbpReviews are
// synced from the live GBP by scripts/sync_brand_reviews.py (real ratings
// only). licenseNumbers / certifications / foundedYear / hours mirror
// plan-input brand truth; responseMinutes mirrors plan-input
// brand.response_minutes (the claims_lint gate) and is absent on older sites.
// The 24/7 test is the same regex as TrustStrip / Header / claims_lint.
//
// LIGHT-THEME VARIANT (astro-starter-light overlay): same logic as the
// starter file, light surfaces only. Keep the two in sync.
// On the homepage this replaces ReviewsStrip (same rating + snippets job, plus
// the credentials), so review quotes are not stacked three times.
// AggregateRating schema is NOT emitted here: schema.ts already embeds it in
// the homepage LocalBusiness block when both GBP fields are present.
import { brand } from "~/lib/brand";
import { Star, Phone } from "@lucide/astro";

const TOP_RATED_MIN_RATING = 4.5;
const TOP_RATED_MIN_REVIEWS = 20;

const B = brand as unknown as Record<string, unknown>;
const str = (v: unknown) => String(v ?? "").trim();

const city = str(brand.primaryCity);
const name = str(brand.displayName);
const trade = str(B.tradeNoun) || "restoration";

const rating = str(brand.gbpRatingValue);
const count = str(brand.gbpReviewCount);
const ratingNum = parseFloat(rating);
const countNum = parseInt(count.replace(/[^0-9]/g, ""), 10);
const hasRating = ratingNum > 0 && countNum > 0;
const topRated = hasRating && ratingNum >= TOP_RATED_MIN_RATING && countNum >= TOP_RATED_MIN_REVIEWS;
const stars = hasRating ? Math.min(5, Math.round(ratingNum)) : 0;
const reviewsUrl = brand.googleCid
  ? `https://www.google.com/maps?cid=${brand.googleCid}`
  : brand.placeId
    ? `https://search.google.com/local/reviews?placeid=${brand.placeId}`
    : "";

// Review excerpts: real synced reviews, 4+ stars, ones that mention the city
// first; trimmed to whole sentences (never mid-word) so the quote stays honest.
function excerpt(text: string, max = 170): string {
  const t = text.replace(/\s+/g, " ").replace(/[…]$|\.\.\.$/, "").trim();
  const sentences = t.match(/[^.!?]+[.!?]+/g) || [];
  let out = "";
  for (const s of sentences) {
    if ((out + s).length > max) break;
    out += s;
  }
  if (out.trim()) return out.trim();
  const cut = t.slice(0, max);
  return `${cut.slice(0, Math.max(cut.lastIndexOf(" "), 40)).trim()}…`;
}
const reviews = ((B.gbpReviews as { author: string; rating: number; text: string; when?: string }[]) || [])
  .filter((r) => r && r.text && (r.rating || 0) >= 4)
  .map((r, i) => ({ ...r, i, local: city && r.text.toLowerCase().includes(city.toLowerCase()) ? 0 : 1 }))
  .sort((a, b) => a.local - b.local || a.i - b.i)
  .slice(0, 3)
  .map((r) => ({ author: r.author, rating: r.rating, when: r.when, quote: excerpt(r.text) }));

const lead = topRated
  ? `${name} is a top-rated ${trade} company in ${city}, with a ${rating}-star Google rating across ${count} reviews.`
  : hasRating && ratingNum >= 4
    ? `${city} homeowners rate ${name} ${rating} out of 5 stars across ${count} Google reviews.`
    : `Here is what ${name} brings to every ${trade} job in ${city}.`;

const show = Boolean(city && name) && (hasRating || reviews.length > 0);
const short = str(brand.shortName);
// the full name if short enough, else the short name, else "us"; the inline
// script under the headline shrinks it until it sits on two lines at most
// (character counts can't predict wrapping: "Why Federal Way homeowners
// choose NARESTCO" is 42 characters and still ran three lines on a phone)
const fits = (n: string) => n.length <= 24;
const headName = fits(name) ? name : short && fits(short) ? short : "us";
---

{show && (
  <section class="bg-dark-50 py-20 border-y border-dark/10 text-dark-900" aria-labelledby="home-proof-heading">
    <div class="container-wide">
      <div class="max-w-4xl mx-auto text-center">
        <div class="eyebrow">Proof, not promises</div>
        <h2 id="home-proof-heading" class="text-base min-[360px]:text-xl sm:text-3xl md:text-4xl text-balance font-black uppercase tracking-tight text-dark-900 mb-4">
          Why {city} homeowners choose {headName}
        </h2>
        <script is:inline>
          (() => {
            const h = document.getElementById("home-proof-heading");
            if (!h) return;
            const fit = () => {
              h.style.fontSize = ""; h.style.lineHeight = "";
              let fs = parseFloat(getComputedStyle(h).fontSize);
              h.style.lineHeight = "1.15";
              for (let i = 0; i < 24 && fs > 14 && h.getBoundingClientRect().height > fs * 1.15 * 2.3; i++) {
                fs -= 1; h.style.fontSize = fs + "px";
              }
            };
            fit();
            addEventListener("resize", fit);
            addEventListener("load", fit);
            // the web font can swap in after the first pass and re-wrap the line
            if (document.fonts) {
              document.fonts.ready.then(fit);
              document.fonts.addEventListener("loadingdone", fit);
            }
          })();
        </script>
        <p class="text-lg text-dark-700 m-0">{lead}</p>
        {stars > 0 && (
          <div class="flex justify-center gap-1 text-amber-500 mt-4" aria-hidden="true">
            {Array.from({ length: stars }).map(() => <Star size={22} class="fill-current" />)}
          </div>
        )}
      </div>

      {reviews.length > 0 && (
        <div class="grid gap-6 md:grid-cols-3 max-w-6xl mx-auto mt-10">
          {reviews.map((r) => (
            <figure class="m-0 p-6 rounded-lg border border-dark/10 bg-white flex flex-col gap-3">
              <div class="flex gap-1 text-amber-500" role="img" aria-label={`${r.rating} out of 5 stars`}>
                {Array.from({ length: Math.min(5, r.rating) }).map(() => <Star size={14} class="fill-current" />)}
              </div>
              <blockquote class="m-0 p-0 border-0 text-dark-700 text-sm leading-relaxed">“{r.quote}”</blockquote>
              <figcaption class="text-dark-500 text-xs font-bold uppercase tracking-widest mt-auto">
                {r.author}, Google review{r.when ? ` · ${r.when}` : ""}
              </figcaption>
            </figure>
          ))}
        </div>
      )}

      <div class="text-center mt-12">
        <a href={`tel:${brand.phoneRaw}`}
           class="inline-flex items-center justify-center gap-2 font-bold px-8 py-3 rounded-md transition-all text-lg shadow-lg bg-cta text-cta-fg hover:bg-cta-hover no-underline">
          <Phone size={20} /> Call {brand.phone}
        </a>
      </div>
    </div>
  </section>
)}
